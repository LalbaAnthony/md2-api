{
  "name": "md2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:charset": "node tools/check-repository-charset.mjs",
    "openapi:export": "node tools/export-openapi.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:golden": "vitest run tests/golden --passWithNoTests",
    "test:visual": "vitest run tests/visual --passWithNoTests",
    "test:contract": "vitest run tests/contract",
    "test:all": "docker compose -f docker/compose.yaml run --rm test",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/under-pressure": "9.2.0",
    "docx": "9.7.1",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "pino": "10.3.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "sharp": "0.35.4",
    "shiki": "4.4.3",
    "undici": "8.10.2",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@types/pngjs": "6.0.5",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "5.0.1",
    "autocannon": "8.0.0",
    "eslint": "10.11.0",
    "fast-xml-parser": "5.11.1",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "yauzl": "3.4.0"
  }
}
