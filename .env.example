NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

THEMES_DIR=./themes
ASSETS_DIR=./assets
DEFAULT_THEME=default
DEFAULT_FORMAT=docx
ENABLED_FORMATS=docx

MAX_MARKDOWN_BYTES=2000000
MAX_CONCURRENCY=4
CONVERT_TIMEOUT_MS=30000
MAX_NESTING_DEPTH=100

ALLOW_REMOTE_IMAGES=false
IMAGE_ALLOWLIST=
ALLOW_LOCAL_IMAGES=false
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_IMAGES_PER_DOCUMENT=100
IMAGE_FETCH_TIMEOUT_MS=5000

STRICT=true
ALLOW_RAW_HTML=false

ENABLE_PREVIEW=true
ENABLE_THEME_WATCH=true
ENABLE_SWAGGER_UI=true
CORS_ORIGINS=
